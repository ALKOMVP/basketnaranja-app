---
const toList = (mods: Record<string, any>, re: RegExp, fallback: string) =>
  Object.entries(mods).map(([path, url]) => ({
    url: url as string,
    name: path.split("/").pop()?.replace(re, "") ?? fallback,
  }));

const videoMods = import.meta.glob("../assets/videos/*.{mp4,webm,mov}", { eager: true, import: "default" });
const photoMods = import.meta.glob("../assets/photos/*.{jpg,jpeg,png,webp,avif}", { eager: true, import: "default" });
const gifMods = import.meta.glob("../assets/gifs/*.{gif,webp}", { eager: true, import: "default" });

const videos = toList(videoMods, /(\.(mp4|webm|mov))$/i, "video");
const photos = toList(photoMods, /(\.(jpg|jpeg|png|webp|avif))$/i, "photo");
const gifs = toList(gifMods, /(\.(gif|webp))$/i, "gif");

const media = [
  ...photos.map((p) => ({ ...p, kind: "photo" as const })),
  ...gifs.map((g) => ({ ...g, kind: "gif" as const })),
  ...videos.map((v) => ({ ...v, kind: "video" as const })),
];

const naracoins = [
  { name: "Fran", amount: 84000, initials: "FR" },
  { name: "Juanma", amount: 84000, initials: "JM" },
  { name: "Sofi", amount: 84000, initials: "SO" },
  { name: "Edu", amount: 84000, initials: "ED" },
  { name: "Nico R", amount: 46500, initials: "NR" },
  { name: "Ari", amount: 40500, initials: "AR" },
].sort((a, b) => b.amount - a.amount || a.name.localeCompare(b.name));

const totalCoins = naracoins.reduce((sum, p) => sum + p.amount, 0);
const maxCoins = Math.max(...naracoins.map((p) => p.amount));
const fmtCoins = (n: number) => n.toLocaleString("es-AR");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Basketnaranja</title>
    <meta name="theme-color" content="#0b0a09" />
    <meta name="description" content="Basketnaranja — Naracoins, pagos y álbum del equipo." />
    <link rel="icon" type="image/png" href="/mascot.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #0b0a09;
        --bg-elev: #141210;
        --panel: rgba(255, 248, 240, 0.045);
        --panel-solid: #161310;
        --ink: #fff8f0;
        --muted: #a89a8c;
        --line: rgba(255, 248, 240, 0.1);
        --orange: #ff7a1a;
        --orange-2: #ff9a4d;
        --amber: #f5c15d;
        --gold: #e8b84a;
        --ok: #34d399;
        --radius: 18px;
        --shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
        --font: "Outfit", sans-serif;
        --display: "Sora", sans-serif;
        --basket-cursor: url("/cursor-basket-32.png") 16 16, pointer;
      }

      * { box-sizing: border-box }
      html { scroll-behavior: smooth }
      html, body { min-height: 100% }
      body {
        margin: 0;
        font-family: var(--font);
        color: var(--ink);
        cursor: auto;
        background:
          radial-gradient(900px 520px at 12% -8%, rgba(255, 122, 26, 0.28), transparent 55%),
          radial-gradient(700px 420px at 92% 8%, rgba(245, 193, 93, 0.12), transparent 50%),
          radial-gradient(600px 400px at 50% 100%, rgba(255, 122, 26, 0.08), transparent 55%),
          linear-gradient(180deg, #120e0b 0%, var(--bg) 40%, #090807 100%);
        background-attachment: fixed;
      }
      a, button, .thumb, .tab, .select, .iconbtn, .qr-hit, label, summary,
      [role="button"], [data-scroll] {
        cursor: pointer;
      }
      .coin-card,
      .coin-card * {
        cursor: var(--basket-cursor);
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.035;
        background-image:
          linear-gradient(rgba(255,248,240,.7) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,248,240,.7) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
      }

      .wrap {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
        padding: 28px 0 72px;
        position: relative;
        z-index: 1;
      }

      /* Header */
      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 36px;
        animation: rise 0.7s ease both;
      }
      .brand { display: flex; align-items: center; gap: 14px; text-decoration: none; color: inherit }
      .logo {
        width: 56px; height: 56px; border-radius: 14px; object-fit: contain;
        background: linear-gradient(145deg, rgba(255,122,26,.25), rgba(255,248,240,.05));
        border: 1px solid var(--line);
        box-shadow: 0 8px 24px rgba(255, 122, 26, 0.15);
      }
      .brand-text { display: grid; gap: 2px }
      .brand-text strong {
        font-family: var(--display);
        font-size: clamp(22px, 4vw, 28px);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.05;
      }
      .brand-text span { font-size: 12px; color: var(--muted); font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase }

      .menu { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end }
      .menu a {
        padding: 10px 14px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        color: var(--ink);
        background: rgba(255,248,240,0.04);
        border: 1px solid var(--line);
        transition: background .2s, border-color .2s, transform .2s;
      }
      .menu a:hover { background: rgba(255,122,26,0.12); border-color: rgba(255,122,26,0.35); transform: translateY(-1px) }

      /* Sections */
      section { margin-bottom: 28px; animation: rise 0.8s ease both }
      section:nth-of-type(1) { animation-delay: .05s }
      section:nth-of-type(2) { animation-delay: .12s }
      section:nth-of-type(3) { animation-delay: .18s }

      .panel {
        background: var(--panel);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: clamp(18px, 3vw, 28px);
        box-shadow: var(--shadow);
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
        flex-wrap: wrap;
      }
      .section-head h2 {
        margin: 0;
        font-family: var(--display);
        font-size: clamp(26px, 4vw, 34px);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.15;
      }
      .section-head p { margin: 6px 0 0; color: var(--muted); font-size: 14px; max-width: 42ch }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--orange-2);
        margin-bottom: 8px;
      }
      .eyebrow::before {
        content: "";
        width: 18px; height: 2px;
        background: linear-gradient(90deg, var(--orange), transparent);
        border-radius: 2px;
      }

      /* Naracoins */
      .coins-summary {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(255,122,26,.16), rgba(245,193,93,.08));
        border: 1px solid rgba(255,122,26,.25);
      }
      .coins-summary .total {
        font-family: var(--display);
        font-size: 22px;
        font-weight: 700;
        color: var(--amber);
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
      }
      .coins-summary .label { font-size: 12px; color: var(--muted) }

      .coins-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }
      @media (max-width: 820px) { .coins-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) } }
      @media (max-width: 480px) { .coins-grid { grid-template-columns: 1fr } }

      .coin-card {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        padding: 16px;
        background: linear-gradient(160deg, rgba(255,248,240,.07), rgba(255,248,240,.02));
        border: 1px solid var(--line);
        transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
      }
      .coin-card:hover {
        transform: translateY(-3px);
        border-color: rgba(255,122,26,.4);
        box-shadow: 0 14px 30px rgba(255,122,26,.12);
      }
      .coin-card.top {
        background: linear-gradient(160deg, rgba(255,122,26,.22), rgba(245,193,93,.08));
        border-color: rgba(255,154,77,.4);
      }
      .coin-card .rank {
        position: absolute;
        top: 12px; right: 12px;
        font-size: 11px;
        font-weight: 700;
        color: var(--muted);
        letter-spacing: 0.06em;
      }
      .coin-card.top .rank { color: var(--amber) }
      .coin-top {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
      }
      .avatar {
        width: 44px; height: 44px;
        border-radius: 50%;
        display: grid; place-items: center;
        font-weight: 800;
        font-size: 13px;
        letter-spacing: 0.02em;
        color: #1a1008;
        background: linear-gradient(145deg, var(--amber), var(--orange));
        box-shadow: 0 0 0 2px rgba(255,248,240,.08), 0 6px 16px rgba(255,122,26,.3);
        flex-shrink: 0;
      }
      .coin-card h3 { margin: 0; font-size: 16px; font-weight: 700 }
      .coin-amount {
        display: flex;
        align-items: baseline;
        gap: 6px;
        margin-bottom: 10px;
      }
      .coin-amount strong {
        font-family: var(--display);
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
        background: linear-gradient(90deg, #fff8f0, var(--amber));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .coin-amount span { font-size: 12px; color: var(--muted); font-weight: 600 }
      .bar-track {
        height: 6px;
        border-radius: 999px;
        background: rgba(255,248,240,.08);
        overflow: hidden;
      }
      .bar-fill {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--orange), var(--amber));
        transform-origin: left;
        animation: grow 1s ease both;
      }

      /* Pagar */
      .pay-simple {
        display: grid;
        gap: 18px;
      }
      .fee-row {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        justify-content: space-between;
        gap: 12px;
      }
      .fee-amount {
        display: grid;
        gap: 4px;
      }
      .fee-amount .label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .fee-amount strong {
        font-family: var(--display);
        font-size: clamp(36px, 7vw, 48px);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1;
        background: linear-gradient(90deg, #fff8f0, var(--amber));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .alias-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }
      .alias-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px 12px 16px;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(255,122,26,.18), rgba(245,193,93,.08));
        border: 1px solid rgba(255,122,26,.35);
        width: fit-content;
        max-width: 100%;
        color: inherit;
        font: inherit;
        cursor: pointer;
        transition: transform .15s, border-color .15s, background .15s;
      }
      .alias-pill:hover {
        transform: translateY(-1px);
        border-color: rgba(255,154,77,.55);
      }
      .alias-pill.copied {
        border-color: rgba(52, 211, 153, 0.55);
        background: linear-gradient(135deg, rgba(52,211,153,.16), rgba(245,193,93,.06));
      }
      .alias-pill .tag {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--orange-2);
      }
      .alias-pill code {
        font-family: var(--display);
        font-size: clamp(18px, 3vw, 22px);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--ink);
      }
      .alias-pill .copy-ico {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: rgba(0,0,0,.22);
        border: 1px solid var(--line);
        flex-shrink: 0;
      }
      .alias-pill .copy-ico svg { width: 16px; height: 16px }
      .cta { display: flex; flex-wrap: wrap; gap: 10px }
      .btn {
        padding: 12px 18px;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: rgba(255,248,240,.05);
        color: var(--ink);
        font-weight: 700;
        font-size: 14px;
        font-family: inherit;
        cursor: pointer;
        text-decoration: none;
        text-align: center;
        transition: transform .15s, filter .15s, background .15s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }
      .btn svg { width: 18px; height: 18px; flex-shrink: 0 }
      .btn:hover { transform: translateY(-1px); background: rgba(255,248,240,.1) }
      .btn.primary {
        background: linear-gradient(135deg, var(--orange), #e85d00);
        border: none;
        color: #fff;
        box-shadow: 0 10px 24px rgba(255,122,26,.35);
      }
      .btn.primary:hover { filter: brightness(1.05) }
      .btn.sm { padding: 8px 12px; font-size: 13px; border-radius: 10px }
      .fineprint { margin: 0; font-size: 12px; color: var(--muted) }

      /* Álbum */
      .album-tools {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        margin-bottom: 16px;
      }
      .tabs {
        display: inline-flex;
        gap: 4px;
        padding: 4px;
        border-radius: 12px;
        background: rgba(0,0,0,.25);
        border: 1px solid var(--line);
      }
      .tab {
        border: 0;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-weight: 650;
        font-size: 13px;
        padding: 8px 12px;
        border-radius: 9px;
        cursor: pointer;
        transition: background .15s, color .15s;
      }
      .tab[aria-selected="true"] {
        background: linear-gradient(135deg, rgba(255,122,26,.9), #e85d00);
        color: #fff;
      }
      .select {
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: rgba(0,0,0,.25);
        color: var(--ink);
        font: inherit;
        font-size: 13px;
      }
      .count { font-size: 12px; color: var(--muted); margin-left: auto }

      .album-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: 8px;
      }
      @media (min-width: 720px) {
        .album-grid { grid-template-columns: repeat(auto-fill, minmax(124px, 1fr)); gap: 10px }
      }

      .thumb {
        position: relative;
        margin: 0;
        aspect-ratio: 1;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--line);
        background: #1a1512;
        cursor: pointer;
        padding: 0;
        width: 100%;
        display: block;
        color: inherit;
        font: inherit;
        transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
      }
      .thumb:hover, .thumb:focus-visible {
        transform: scale(1.03);
        border-color: rgba(255,122,26,.55);
        box-shadow: 0 10px 24px rgba(0,0,0,.35);
        outline: none;
        z-index: 2;
      }
      .thumb img, .thumb video {
        width: 100%; height: 100%;
        object-fit: cover;
        display: block;
        pointer-events: none;
      }
      .thumb .badge {
        position: absolute;
        left: 8px; bottom: 8px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        background: rgba(0,0,0,.65);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.12);
      }
      .thumb .play {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,.45));
      }
      .thumb .play span {
        width: 34px; height: 34px;
        border-radius: 50%;
        display: grid; place-items: center;
        background: rgba(255,122,26,.92);
        box-shadow: 0 6px 16px rgba(0,0,0,.35);
      }
      .thumb .play svg { width: 14px; height: 14px; margin-left: 2px }

      .pager {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 18px;
      }
      .pager .page-info { font-size: 13px; color: var(--muted); min-width: 8ch; text-align: center }

      /* Lightbox */
      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(5,4,3,.82);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
      }
      .lightbox.open { display: flex; animation: fade .2s ease }
      .lb-shell {
        width: min(960px, 100%);
        max-height: calc(100vh - 40px);
        overflow: auto;
        background: var(--panel-solid);
        border: 1px solid var(--line);
        border-radius: 20px;
        box-shadow: 0 30px 80px rgba(0,0,0,.55);
        padding: 16px;
        animation: pop .25s ease;
      }
      .lb-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
      }
      .lb-title {
        margin: 0;
        font-size: 14px;
        font-weight: 600;
        color: var(--muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .lb-actions { display: flex; gap: 6px; flex-shrink: 0 }
      .iconbtn {
        width: 40px; height: 40px;
        display: grid; place-items: center;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: rgba(255,248,240,.05);
        color: var(--ink);
        cursor: pointer;
      }
      .iconbtn:hover { background: rgba(255,122,26,.18); border-color: rgba(255,122,26,.4) }
      .iconbtn svg { width: 18px; height: 18px }
      .lb-media {
        border-radius: 14px;
        overflow: hidden;
        background: #000;
        display: grid;
        place-items: center;
        min-height: 220px;
      }
      .lb-media img, .lb-media video {
        max-width: 100%;
        max-height: min(62vh, 640px);
        display: block;
      }
      .lb-nav {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 12px;
      }

      /* Clipper in lightbox */
      .clipper { margin-top: 14px; display: none; gap: 10px }
      .lightbox[data-kind="video"] .clipper { display: grid }
      .trimbar { display: grid; gap: 8px }
      .track { position: relative; height: 48px; user-select: none }
      .rail {
        position: absolute; left: 0; right: 0; height: 8px; top: 50%;
        transform: translateY(-50%); border-radius: 999px;
        background: rgba(255,248,240,.12); z-index: 0;
      }
      .fill {
        position: absolute; height: 8px; top: 50%; transform: translateY(-50%);
        border-radius: 999px; background: var(--orange); z-index: 1;
      }
      .handle {
        position: absolute; top: 50%; transform: translate(-50%, -50%);
        width: 22px; height: 22px; border-radius: 50%;
        background: var(--orange); border: 3px solid #fff;
        box-shadow: 0 2px 6px rgba(0,0,0,.35); cursor: grab; touch-action: none; z-index: 3;
      }
      .handle:active { cursor: grabbing }
      .playhead {
        position: absolute; top: 50%; transform: translate(-50%, -50%);
        width: 2px; height: 22px; background: #fff; border-radius: 1px;
        z-index: 2; display: none;
      }
      .lightbox.is-previewing .playhead { display: block }
      .trim-info {
        display: flex; justify-content: space-between; align-items: center;
        font-size: 12px; color: var(--muted);
      }
      .trim-actions { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap }
      .overlay {
        position: absolute; inset: 0; border-radius: 14px;
        background: rgba(11,10,9,.92); display: none; place-items: center;
        place-content: center; gap: 8px; padding: 14px; z-index: 20;
      }
      .lightbox.is-clipping .overlay { display: grid }
      .lb-media { position: relative }
      .spinner {
        width: 32px; height: 32px; border-radius: 50%;
        border: 3px solid rgba(255,248,240,.15); border-top-color: var(--orange);
        animation: spin .8s linear infinite;
      }
      .progress {
        width: min(100%, 320px); height: 8px;
        background: rgba(255,248,240,.12); border-radius: 999px; overflow: hidden;
      }
      .bar { width: 0%; height: 100%; background: var(--orange); transition: width .1s linear }

      @keyframes spin { to { transform: rotate(360deg) } }
      @keyframes rise {
        from { opacity: 0; transform: translateY(14px) }
        to { opacity: 1; transform: none }
      }
      @keyframes grow {
        from { transform: scaleX(0) }
        to { transform: scaleX(1) }
      }
      @keyframes fade { from { opacity: 0 } to { opacity: 1 } }
      @keyframes pop {
        from { opacity: 0; transform: scale(.96) translateY(8px) }
        to { opacity: 1; transform: none }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="header">
        <a class="brand" href="/">
          <img src="/mascot.png" alt="Basketnaranja" class="logo" />
          <div class="brand-text">
            <strong>Basketnaranja</strong>
            <span>Club &amp; temporada</span>
          </div>
        </a>
        <nav class="menu" aria-label="Secciones">
          <a href="#naracoins" data-scroll="naracoins">Naracoins</a>
          <a href="#pagar" data-scroll="pagar">Pagar</a>
          <a href="#album" data-scroll="album">Álbum</a>
        </nav>
      </header>

      <!-- Naracoins -->
      <section class="panel" id="naracoins">
        <div class="section-head">
          <div>
            <div class="eyebrow">Créditos</div>
            <h2>Naracoins</h2>
            <p>Saldo actual de cada uno.</p>
          </div>
          <div class="coins-summary" aria-label="Total del pool">
            <div>
              <div class="label">Pool total</div>
              <div class="total">{fmtCoins(totalCoins)}</div>
            </div>
          </div>
        </div>

        <div class="coins-grid">
          {naracoins.map((p, i) => (
            <article class={`coin-card${i < 4 && p.amount === maxCoins ? " top" : ""}`}>
              <div class="rank">#{i + 1}</div>
              <div class="coin-top">
                <div class="avatar" aria-hidden="true">{p.initials}</div>
                <h3>{p.name}</h3>
              </div>
              <div class="coin-amount">
                <strong>{fmtCoins(p.amount)}</strong>
                <span>NC</span>
              </div>
              <div class="bar-track" aria-hidden="true">
                <div class="bar-fill" style={`width:${Math.round((p.amount / maxCoins) * 100)}%`}></div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Pagar -->
      <section class="panel" id="pagar">
        <div class="section-head">
          <div>
            <div class="eyebrow">Fecha</div>
            <h2>Pagar</h2>
            <p>Transferí <strong>$6.000</strong> al alias basketnaranja.</p>
          </div>
        </div>
        <div class="pay-simple">
          <div class="fee-row">
            <div class="fee-amount">
              <span class="label">Monto de la fecha</span>
              <strong>$6.000</strong>
            </div>
          </div>

          <div class="alias-row">
            <button class="alias-pill" type="button" id="aliasPill" aria-label="Copiar alias basketnaranja">
              <span class="tag">Alias</span>
              <code id="aliasValue">basketnaranja</code>
              <span class="copy-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                  <path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"></path>
                </svg>
              </span>
            </button>
          </div>

          <div class="cta">
            <button class="btn primary" id="openMp" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="7" y="2" width="10" height="20" rx="2"></rect>
                <path d="M11 18h2"></path>
              </svg>
              Abrir Mercado Pago
            </button>
          </div>
          <p class="fineprint" id="payFeedback">Copiá el alias y transferí $6.000</p>
        </div>
      </section>

      <!-- Álbum -->
      <section class="panel" id="album">
        <div class="section-head">
          <div>
            <div class="eyebrow">Galería</div>
            <h2>Álbum</h2>
            <p>Miniaturas densas. Tocá para ampliar sin salir de la página.</p>
          </div>
        </div>

        <div class="album-tools">
          <div class="tabs" role="tablist" aria-label="Tipo de media">
            <button class="tab" type="button" role="tab" data-filter="all" aria-selected="true">Todo</button>
            <button class="tab" type="button" role="tab" data-filter="photo" aria-selected="false">Fotos</button>
            <button class="tab" type="button" role="tab" data-filter="video" aria-selected="false">Videos</button>
          </div>
          <label for="dateFilter" class="sr-only" style="position:absolute;left:-9999px">Fecha</label>
          <select id="dateFilter" class="select" aria-label="Filtrar por fecha">
            <option value="">Todas las fechas</option>
          </select>
          <button id="clearFilter" class="btn sm" type="button">Limpiar</button>
          <span class="count" id="mediaCount"></span>
        </div>

        {media.length > 0 ? (
          <div class="album-grid" id="albumGrid">
            {media.map((item, idx) => (
              <button
                class="thumb"
                type="button"
                data-index={idx}
                data-kind={item.kind === "gif" ? "photo" : item.kind}
                data-url={item.url}
                data-name={item.name}
                data-date=""
                aria-label={`Abrir ${item.name}`}
              >
                {item.kind === "video" ? (
                  <>
                    <video src={`${item.url}#t=0.1`} muted playsinline preload="metadata"></video>
                    <div class="play" aria-hidden="true">
                      <span>
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
                      </span>
                    </div>
                    <span class="badge">Video</span>
                  </>
                ) : (
                  <>
                    <img src={item.url} alt={item.name} loading="lazy" decoding="async" />
                    <span class="badge">{item.kind === "gif" ? "GIF" : "Foto"}</span>
                  </>
                )}
              </button>
            ))}
          </div>
        ) : (
          <p class="lead" style="color:var(--muted)">Aún no hay media en el álbum.</p>
        )}

        <div class="pager" id="pager" hidden>
          <button class="btn sm" type="button" id="prevPage">Anterior</button>
          <span class="page-info" id="pageInfo">1 / 1</span>
          <button class="btn sm" type="button" id="nextPage">Siguiente</button>
        </div>
      </section>
    </div>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Vista ampliada" data-kind="photo">
      <div class="lb-shell">
        <div class="lb-top">
          <h3 class="lb-title" id="lbTitle">Media</h3>
          <div class="lb-actions">
            <button class="iconbtn" type="button" id="lbPrev" aria-label="Anterior">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button class="iconbtn" type="button" id="lbNext" aria-label="Siguiente">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </button>
            <button class="iconbtn" type="button" id="lbClose" aria-label="Cerrar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
        </div>

        <div class="lb-media" id="lbMedia">
          <img id="lbImage" alt="" hidden />
          <video id="lbVideo" controls playsinline preload="metadata" hidden></video>
          <div class="overlay">
            <div class="spinner" aria-hidden="true"></div>
            <div style="font-weight:700;color:var(--orange-2)">Recortando…</div>
            <div style="font-size:13px;color:var(--muted)">Generando clip en tu navegador</div>
            <div class="progress"><div class="bar" id="clipBar"></div></div>
          </div>
        </div>

        <div class="clipper" id="clipper">
          <div class="trimbar">
            <div class="track" id="trimTrack">
              <div class="rail"></div>
              <div class="fill" id="trimFill"></div>
              <div class="handle h-start" id="hStart" tabindex="0" aria-label="Inicio"></div>
              <div class="handle h-end" id="hEnd" tabindex="0" aria-label="Fin"></div>
              <div class="playhead" id="playhead"></div>
            </div>
            <div class="trim-info">
              <span id="tStart">00:00</span>
              <span id="tLen">00:00</span>
              <span id="tEnd">00:00</span>
            </div>
          </div>
          <div class="trim-actions">
            <button class="btn sm" type="button" id="btnPreview">Previsualizar</button>
            <button class="btn primary sm" type="button" id="btnClip">Recortar y descargar</button>
          </div>
        </div>

        <div class="lb-nav">
          <button class="btn sm" type="button" id="lbPrev2">← Anterior</button>
          <button class="btn sm" type="button" id="lbNext2">Siguiente →</button>
        </div>
      </div>
    </div>

    <script is:inline>
      const ALIAS = "basketnaranja";
      const PAGE_SIZE = 36;

      async function copyAlias(feedback, pill) {
        try {
          await navigator.clipboard.writeText(ALIAS);
          if (feedback) {
            const old = feedback.textContent;
            feedback.textContent = "Alias copiado: basketnaranja";
            setTimeout(() => (feedback.textContent = old), 2000);
          }
          if (pill) {
            pill.classList.add("copied");
            setTimeout(() => pill.classList.remove("copied"), 1600);
          }
          return true;
        } catch {
          return false;
        }
      }

      function openMercadoPago() {
        if (/Android/i.test(navigator.userAgent)) {
          window.location.href =
            "intent://home#Intent;scheme=mercadopago;package=com.mercadopago.wallet;" +
            "S.browser_fallback_url=" +
            encodeURIComponent("https://www.mercadopago.com.ar/home") +
            ";end";
          return;
        }
        if (/iPhone|iPad|iPod/i.test(navigator.userAgent)) {
          window.location.href = "mercadopago://";
          setTimeout(() => {
            window.location.href = "https://www.mercadopago.com.ar/home";
          }, 900);
          return;
        }
        window.open("https://www.mercadopago.com.ar/home", "_blank", "noopener,noreferrer");
      }

      // Smooth scroll
      function scrollToId(id) {
        const el = document.getElementById(id);
        if (!el) return;
        const y = el.getBoundingClientRect().top + window.scrollY - 16;
        window.scrollTo({ top: y, behavior: "smooth" });
      }
      function getSlug(pathname) {
        const p = pathname.split("?")[0].split("#")[0].split("/").filter(Boolean);
        return p[p.length - 1] || "";
      }
      function routeToSection() {
        const slug = location.hash.replace("#", "") || getSlug(location.pathname);
        if (["naracoins", "pagar", "album", "videos"].includes(slug)) {
          scrollToId(slug === "videos" ? "album" : slug);
        }
      }
      document.querySelectorAll("[data-scroll]").forEach((a) => {
        a.addEventListener("click", (e) => {
          e.preventDefault();
          const id = a.getAttribute("data-scroll");
          history.pushState({}, "", "/#" + id);
          routeToSection();
        });
      });
      window.addEventListener("DOMContentLoaded", routeToSection);
      window.addEventListener("popstate", routeToSection);
      window.addEventListener("hashchange", routeToSection);

      // Alias + abrir Mercado Pago
      const payFeedback = document.getElementById("payFeedback");
      const aliasPill = document.getElementById("aliasPill");
      aliasPill?.addEventListener("click", async () => {
        await copyAlias(payFeedback, aliasPill);
      });
      document.getElementById("openMp")?.addEventListener("click", async () => {
        await copyAlias(payFeedback, aliasPill);
        openMercadoPago();
      });

      // ===== Álbum: filtro + paginación + lightbox =====
      (function () {
        const grid = document.getElementById("albumGrid");
        const sel = document.getElementById("dateFilter");
        const countEl = document.getElementById("mediaCount");
        const clearBtn = document.getElementById("clearFilter");
        const pager = document.getElementById("pager");
        const pageInfo = document.getElementById("pageInfo");
        const prevPage = document.getElementById("prevPage");
        const nextPage = document.getElementById("nextPage");
        const tabs = Array.from(document.querySelectorAll(".tab"));
        if (!grid) return;

        const thumbs = Array.from(grid.querySelectorAll(".thumb"));
        const extract = (text) => {
          const m = (text || "").match(/(20\d{2})[\-_/ ](\d{2})[\-_/ ](\d{2})/);
          return m ? `${m[1]}-${m[2]}-${m[3]}` : "";
        };

        const dates = new Set();
        for (const t of thumbs) {
          const d = extract(t.dataset.name || "");
          if (d) {
            t.dataset.date = d;
            dates.add(d);
          }
        }
        Array.from(dates)
          .sort((a, b) => b.localeCompare(a))
          .forEach((d) => {
            const opt = document.createElement("option");
            opt.value = d;
            opt.textContent = d;
            sel.appendChild(opt);
          });

        let kindFilter = "all";
        let dateFilter = "";
        let page = 1;

        function filtered() {
          return thumbs.filter((t) => {
            const kindOk = kindFilter === "all" || t.dataset.kind === kindFilter;
            const dateOk = !dateFilter || t.dataset.date === dateFilter;
            return kindOk && dateOk;
          });
        }

        function render() {
          const list = filtered();
          const pages = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
          if (page > pages) page = pages;
          const start = (page - 1) * PAGE_SIZE;
          const visible = new Set(list.slice(start, start + PAGE_SIZE));

          thumbs.forEach((t) => {
            t.hidden = !visible.has(t);
          });

          if (countEl) {
            countEl.textContent = `${list.length} ítem${list.length === 1 ? "" : "s"}`;
          }
          if (pager) {
            pager.hidden = list.length <= PAGE_SIZE;
            pageInfo.textContent = `${page} / ${pages}`;
            prevPage.disabled = page <= 1;
            nextPage.disabled = page >= pages;
          }
        }

        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            tabs.forEach((t) => t.setAttribute("aria-selected", "false"));
            tab.setAttribute("aria-selected", "true");
            kindFilter = tab.dataset.filter || "all";
            page = 1;
            render();
          });
        });

        sel.addEventListener("change", () => {
          dateFilter = sel.value;
          page = 1;
          render();
          const url = new URL(location.href);
          if (dateFilter) url.searchParams.set("date", dateFilter);
          else url.searchParams.delete("date");
          history.replaceState({}, "", url);
        });
        clearBtn?.addEventListener("click", () => {
          sel.value = "";
          dateFilter = "";
          kindFilter = "all";
          tabs.forEach((t) => t.setAttribute("aria-selected", t.dataset.filter === "all" ? "true" : "false"));
          page = 1;
          render();
          const url = new URL(location.href);
          url.searchParams.delete("date");
          history.replaceState({}, "", url);
        });
        prevPage?.addEventListener("click", () => {
          page = Math.max(1, page - 1);
          render();
          scrollToId("album");
        });
        nextPage?.addEventListener("click", () => {
          page += 1;
          render();
          scrollToId("album");
        });

        const d0 = new URL(location.href).searchParams.get("date") || "";
        if (d0) {
          sel.value = d0;
          dateFilter = d0;
        }
        render();

        // Lightbox
        const lb = document.getElementById("lightbox");
        const lbTitle = document.getElementById("lbTitle");
        const lbImage = document.getElementById("lbImage");
        const lbVideo = document.getElementById("lbVideo");
        let currentList = [];
        let currentIdx = 0;

        function openAt(globalIndex) {
          currentList = filtered();
          currentIdx = currentList.findIndex((t) => Number(t.dataset.index) === globalIndex);
          if (currentIdx < 0) currentIdx = 0;
          showCurrent();
          lb.classList.add("open");
          document.body.style.overflow = "hidden";
        }

        function closeLb() {
          lb.classList.remove("open", "is-previewing", "is-clipping");
          document.body.style.overflow = "";
          try {
            lbVideo.pause();
          } catch {}
          lbVideo.removeAttribute("src");
          lbVideo.load();
        }

        function showCurrent() {
          const item = currentList[currentIdx];
          if (!item) return;
          const kind = item.dataset.kind;
          const url = item.dataset.url;
          const name = item.dataset.name || "";
          lb.dataset.kind = kind;
          lbTitle.textContent = name;
          lb.classList.remove("is-previewing", "is-clipping");

          if (kind === "video") {
            lbImage.hidden = true;
            lbVideo.hidden = false;
            lbVideo.src = url;
            setupTrimmer();
          } else {
            try {
              lbVideo.pause();
            } catch {}
            lbVideo.hidden = true;
            lbVideo.removeAttribute("src");
            lbImage.hidden = false;
            lbImage.src = url;
            lbImage.alt = name;
          }
        }

        function step(dir) {
          if (!currentList.length) return;
          currentIdx = (currentIdx + dir + currentList.length) % currentList.length;
          showCurrent();
        }

        thumbs.forEach((t) => {
          t.addEventListener("click", () => openAt(Number(t.dataset.index)));
        });

        document.getElementById("lbClose")?.addEventListener("click", closeLb);
        document.getElementById("lbPrev")?.addEventListener("click", () => step(-1));
        document.getElementById("lbNext")?.addEventListener("click", () => step(1));
        document.getElementById("lbPrev2")?.addEventListener("click", () => step(-1));
        document.getElementById("lbNext2")?.addEventListener("click", () => step(1));
        lb.addEventListener("click", (e) => {
          if (e.target === lb) closeLb();
        });
        window.addEventListener("keydown", (e) => {
          if (!lb.classList.contains("open")) return;
          if (e.key === "Escape") closeLb();
          if (e.key === "ArrowLeft") step(-1);
          if (e.key === "ArrowRight") step(1);
        });

        // ===== Recorte (lightbox) =====
        const track = document.getElementById("trimTrack");
        const fill = document.getElementById("trimFill");
        const startH = document.getElementById("hStart");
        const endH = document.getElementById("hEnd");
        const playhead = document.getElementById("playhead");
        const tStart = document.getElementById("tStart");
        const tEnd = document.getElementById("tEnd");
        const tLen = document.getElementById("tLen");
        const btnPrev = document.getElementById("btnPreview");
        const btnClip = document.getElementById("btnClip");
        const bar = document.getElementById("clipBar");

        const fmt = (t) => {
          const s = Math.floor(t % 60)
            .toString()
            .padStart(2, "0");
          const m = Math.floor((t / 60) % 60)
            .toString()
            .padStart(2, "0");
          const h = Math.floor(t / 3600);
          return h ? `${h}:${m}:${s}` : `${m}:${s}`;
        };
        const ensureMeta = (v) =>
          v.readyState >= 1
            ? Promise.resolve()
            : new Promise((res) => v.addEventListener("loadedmetadata", res, { once: true }));
        const seekTo = (v, t) =>
          new Promise((res) => {
            const T = Math.max(0, Math.min(t, isFinite(v.duration) ? v.duration : t));
            v.addEventListener("seeked", res, { once: true });
            v.currentTime = T;
          });
        const pickMime = () =>
          [
            "video/webm;codecs=vp9,opus",
            "video/webm;codecs=vp8,opus",
            "video/webm",
            "video/mp4;codecs=h264,aac",
            "video/mp4",
          ].find((t) => window.MediaRecorder && MediaRecorder.isTypeSupported?.(t)) || "";
        const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
        async function getVideoStream(video) {
          const fn = video.captureStream || video.mozCaptureStream || video.webkitCaptureStream;
          if (!fn) return null;
          const s = fn.call(video);
          if (!s.getVideoTracks().length && !s.getAudioTracks().length) {
            const t = video.currentTime,
              w = video.paused;
            video.muted = true;
            try {
              await video.play();
              await sleep(50);
            } catch {}
            try {
              video.pause();
            } catch {}
            try {
              video.currentTime = t;
            } catch {}
            if (w) {
              try {
                video.pause();
              } catch {}
            }
          }
          return s;
        }
        async function ensureFFmpeg() {
          if (window.FFmpeg) return window.FFmpeg;
          await new Promise((res, rej) => {
            const s = document.createElement("script");
            s.src = "https://unpkg.com/@ffmpeg/ffmpeg@0.12.6/dist/ffmpeg.min.js";
            s.onload = res;
            s.onerror = rej;
            document.head.appendChild(s);
          });
          return window.FFmpeg;
        }
        async function trimWithFFmpeg(src, start, end, onProgress) {
          const FF = await ensureFFmpeg();
          const { createFFmpeg, fetchFile } = FF;
          const ff = createFFmpeg({ log: false, progress: ({ ratio }) => onProgress?.(ratio || 0) });
          await ff.load();
          const data = await fetchFile(src);
          ff.FS("writeFile", "in.bin", data);
          try {
            await ff.run("-ss", String(start), "-to", String(end), "-i", "in.bin", "-c", "copy", "out.mp4");
            const out = ff.FS("readFile", "out.mp4");
            return new Blob([out.buffer], { type: "video/mp4" });
          } catch {
            await ff.run(
              "-ss",
              String(start),
              "-to",
              String(end),
              "-i",
              "in.bin",
              "-c:v",
              "libvpx-vp9",
              "-c:a",
              "libopus",
              "-b:v",
              "1M",
              "out.webm"
            );
            const out = ff.FS("readFile", "out.webm");
            return new Blob([out.buffer], { type: "video/webm" });
          }
        }

        const MIN_GAP = 0.2;
        let dur = 0,
          startPct = 0,
          endPct = 1,
          dragging = null;

        const minGapPct = () => (dur ? MIN_GAP / dur : 0);
        const setPositions = () => {
          const l = startPct * 100,
            r = endPct * 100;
          startH.style.left = l + "%";
          endH.style.left = r + "%";
          fill.style.left = l + "%";
          fill.style.width = Math.max(0, r - l) + "%";
          const s = dur * startPct,
            e = dur * endPct;
          tStart.textContent = fmt(s || 0);
          tEnd.textContent = fmt(e || 0);
          tLen.textContent = fmt(Math.max(0, e - s));
        };
        const pctFromEvent = (ev) => {
          const rect = track.getBoundingClientRect();
          const x = "touches" in ev && ev.touches?.length ? ev.touches[0].clientX : ev.clientX;
          return Math.max(0, Math.min(1, (x - rect.left) / rect.width));
        };
        const onMove = (ev) => {
          let p = pctFromEvent(ev),
            mg = minGapPct();
          if (dragging === "start") startPct = Math.min(endPct - mg, p);
          if (dragging === "end") endPct = Math.max(startPct + mg, p);
          setPositions();
        };
        const endDrag = () => {
          dragging = null;
          window.removeEventListener("pointermove", onMove);
        };
        const startDrag = (w) => (ev) => {
          dragging = w;
          ev.preventDefault();
          window.addEventListener("pointermove", onMove);
          window.addEventListener("pointerup", endDrag, { once: true });
        };
        startH.addEventListener("pointerdown", startDrag("start"));
        endH.addEventListener("pointerdown", startDrag("end"));
        track.addEventListener("pointerdown", (ev) => {
          if (ev.target === startH || ev.target === endH) return;
          const p = pctFromEvent(ev),
            mg = minGapPct();
          if (Math.abs(p - startPct) <= Math.abs(p - endPct)) startPct = Math.min(endPct - mg, p);
          else endPct = Math.max(startPct + mg, p);
          setPositions();
        });

        function setupTrimmer() {
          dur = 0;
          startPct = 0;
          endPct = 1;
          setPositions();
          ensureMeta(lbVideo).then(() => {
            dur = lbVideo.duration || 0;
            startPct = 0;
            endPct = 1;
            setPositions();
          });
        }

        btnPrev?.addEventListener("click", async () => {
          await ensureMeta(lbVideo);
          lb.classList.add("is-previewing");
          try {
            const s = dur * startPct,
              e = dur * endPct;
            lbVideo.muted = true;
            await seekTo(lbVideo, s);
            const update = () => {
              const p = Math.min(1, Math.max(0, (lbVideo.currentTime - s) / Math.max(1e-6, e - s)));
              playhead.style.left = (startPct + p * (endPct - startPct)) * 100 + "%";
              if (lbVideo.currentTime >= e) {
                lbVideo.pause();
                lbVideo.removeEventListener("timeupdate", update);
                lb.classList.remove("is-previewing");
              }
            };
            lbVideo.addEventListener("timeupdate", update);
            await lbVideo.play();
          } catch {
            lb.classList.remove("is-previewing");
          }
        });

        btnClip?.addEventListener("click", async () => {
          await ensureMeta(lbVideo);
          const s = dur * startPct,
            e = dur * endPct;
          btnClip.disabled = true;
          btnClip.textContent = "Cortando…";
          lb.classList.add("is-clipping");
          bar.style.width = "0%";
          const nameBase = (lbTitle.textContent || "clip").replace(/\s+/g, "-");
          let usedFF = false;
          let oldTime = lbVideo.currentTime,
            wasPaused = lbVideo.paused,
            oldVis = lbVideo.style.visibility;
          try {
            const mime = pickMime();
            const stream = await getVideoStream(lbVideo);
            if (!mime || !stream) throw new Error("no-capture");
            lbVideo.muted = true;
            lbVideo.style.visibility = "hidden";
            await seekTo(lbVideo, s);
            let chunks = [];
            const rec = new MediaRecorder(stream, { mimeType: mime });
            rec.ondataavailable = (ev) => ev.data && ev.data.size && chunks.push(ev.data);
            const stopped = new Promise((res) => (rec.onstop = res));
            rec.start();
            const updateProg = () => {
              const pct = Math.min(1, Math.max(0, (lbVideo.currentTime - s) / Math.max(1e-6, e - s)));
              bar.style.width = pct * 100 + "%";
              if (lbVideo.currentTime >= e) {
                try {
                  rec.requestData?.();
                } catch {}
                try {
                  rec.stop();
                } catch {}
                lbVideo.removeEventListener("timeupdate", updateProg);
              }
            };
            lbVideo.addEventListener("timeupdate", updateProg);
            await lbVideo.play();
            await stopped;
            const blob = new Blob(chunks, { type: mime });
            if (!blob.size) throw new Error("empty");
            const ext = (mime.split("/")[1] || "webm").split(";")[0];
            const url = URL.createObjectURL(blob);
            const a = Object.assign(document.createElement("a"), {
              href: url,
              download: `${nameBase}-${fmt(s).replace(/:/g, "")}-${fmt(e).replace(/:/g, "")}.${ext}`,
            });
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
          } catch {
            usedFF = true;
            try {
              const blob = await trimWithFFmpeg(lbVideo.currentSrc || lbVideo.src, s, e, (r) => (bar.style.width = r * 100 + "%"));
              const ext = blob.type.includes("mp4") ? "mp4" : "webm";
              const url = URL.createObjectURL(blob);
              const a = Object.assign(document.createElement("a"), {
                href: url,
                download: `${nameBase}-${fmt(s).replace(/:/g, "")}-${fmt(e).replace(/:/g, "")}.${ext}`,
              });
              document.body.appendChild(a);
              a.click();
              a.remove();
              URL.revokeObjectURL(url);
            } catch (e2) {
              console.error(e2);
              alert("No se pudo generar el recorte.\nProbá en Chrome/Edge de escritorio o volvé a intentar.");
            }
          } finally {
            if (!usedFF) {
              try {
                lbVideo.pause();
              } catch {}
              try {
                lbVideo.currentTime = oldTime;
              } catch {}
              lbVideo.style.visibility = oldVis || "";
              if (!wasPaused) {
                try {
                  await lbVideo.play();
                } catch {}
              } else {
                try {
                  lbVideo.pause();
                } catch {}
              }
            }
            btnClip.disabled = false;
            btnClip.textContent = "Recortar y descargar";
            lb.classList.remove("is-clipping");
            bar.style.width = "0%";
          }
        });
      })();
    </script>
  </body>
</html>
